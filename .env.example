# Documentation only: the application does NOT automatically load .env.
# Set process/service environment values. Replace every credential placeholder.
# ACTIVE PROFILE: LOCAL LOOPBACK EVALUATION ONLY.
ITSM_ENV=development
ITSM_DB=./evaluation.db
ITSM_INITIAL_ADMIN_PASSWORD=REPLACE_WITH_UNIQUE_PASSWORD_AT_LEAST_12_CHARACTERS
ITSM_SECRET_KEY=REPLACE_WITH_STABLE_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
ITSM_TLS=0
ITSM_HTTPS=0
ITSM_DEBUG=0
ITSM_HOST=127.0.0.1
ITSM_ALLOWED_HOSTS=localhost,127.0.0.1
PORT=5000
ITSM_BACKUP=0

# SEPARATE DIRECT HTTPS REFERENCE: not deployment approval.
# Do not combine with active HTTP values or invoke the HTTP startup helpers.
# ITSM_ENV=production
# ITSM_DB=/absolute/path/to/supported-site.sqlite
# ITSM_SECRET_KEY=PROVISION_STABLE_RANDOM_SECRET_THROUGH_SECRET_MANAGER
# ITSM_INITIAL_ADMIN_PASSWORD=PROVISION_ONLY_FOR_A_NEW_EMPTY_DATABASE
# ITSM_TLS=1
# ITSM_HTTPS=1
# ITSM_DEBUG=0
# ITSM_HOST=127.0.0.1
# ITSM_ALLOWED_HOSTS=itsm.example.invalid,localhost
# ITSM_CERT=/absolute/path/to/organization-trusted-cert.pem
# ITSM_KEY=/absolute/path/to/private-key.pem
# ITSM_HTTPS_PORT=5443
# ITSM_HTTP_REDIRECT=0
# PORT=5000
# ITSM_BACKUP=1
#
# Replace paths/hostname and protect key/secret access at OS level.
# Explicit relative DB paths resolve against the working directory.
# Default DB/backups are beside app.py; there is no backup-directory env var.
# Backups default ON and can start during import. Tests set ITSM_BACKUP=0.
# ITSM_THREADS=8 affects HTTP Waitress only; HTTPS Cheroot uses 16 threads.
# ITSM_CERT_HOSTS supplies generated local test certificate names only.
# SMTP settings live in the administrator UI/database, not SMTP_* env vars.
# Production SMTP requires verified implicit TLS; real relay not certified.
# See README.md, PHASE_0_SCOPE.md and docs/ARCHITECTURE_AND_SECURITY_CONTRACTS.md.
